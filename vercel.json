{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/cinematic.js": {
      "maxDuration": 30
    },
    "api/simulate.js": {
      "maxDuration": 30
    },
    "api/portfolio-events.js": {
      "maxDuration": 30
    },
    "api/narrate.js": {
      "maxDuration": 60
    }
  },
  "crons": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
