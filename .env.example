SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose this key to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=

PORTFOLIO_SIMULATION_TOKEN=
PORTFOLIO_OUTBOX_TOKEN=

# Preferred durable path: Vercel apps publish to the Portal relay; ORQEVIA consumes the relay.
PORTFOLIO_RELAY_URL=https://the-portal-ten.vercel.app/api/portfolio-relay
PORTFOLIO_RELAY_TOKEN=

# Optional direct delivery for a separately secured ORQEVIA integration endpoint.
PRIME_BASE_URL=
PRIME_SPINE_TOKEN=

# AI Gateway routing. OIDC is injected automatically on Vercel.
GAME_NARRATION_MODEL=openai/gpt-5.4-nano
GAME_NARRATION_FALLBACK_MODELS=google/gemini-3.6-flash,alibaba/qwen3.7-flash
CINEMATIC_GENERATION_ENABLED=false
CINEMATIC_VIDEO_MODEL=google/veo-3.1-generate-001

# Production defaults to the existing backend. Preview requires a different project.
GAME_SUPABASE_URL=

# Browser-visible: publishable key or legacy anon JWT only; never a secret/service-role key.
GAME_SUPABASE_PUBLISHABLE_KEY=
AI_GATEWAY_API_KEY=
# Optional locally persisted outbox. No cron is registered until commissioned.
CRON_SECRET=
PRIME_EVENT_URL=

# Prefer time to first token without requesting a premium service tier.
GAME_NARRATION_PROVIDER_SORT=ttft

# Game turns are database-intensive; production database region is Singapore.
GAME_SUPABASE_FUNCTION_REGION=ap-southeast-1

# Short narrative turns do not need a reasoning delay; rules remain server-authoritative.
GAME_NARRATION_REASONING_EFFORT=none
