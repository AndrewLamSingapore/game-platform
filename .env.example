SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose this key to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=

PORTFOLIO_SIMULATION_TOKEN=
PORTFOLIO_OUTBOX_TOKEN=

# Preferred durable path: Vercel apps publish to the Portal relay; PRIME polls from Dell.
PORTFOLIO_RELAY_URL=https://the-portal-ten.vercel.app/api/portfolio-relay
PORTFOLIO_RELAY_TOKEN=

# Optional direct delivery for a separately secured PRIME integration endpoint.
PRIME_BASE_URL=
PRIME_SPINE_TOKEN=

# AI Gateway routing. OIDC is injected automatically on Vercel.
GAME_NARRATION_MODEL=openai/gpt-5.4-nano
GAME_NARRATION_FALLBACK_MODELS=google/gemini-3.6-flash,alibaba/qwen3.7-flash
CINEMATIC_GENERATION_ENABLED=false
CINEMATIC_VIDEO_MODEL=google/veo-3.1-generate-001
